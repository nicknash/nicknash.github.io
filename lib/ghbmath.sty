% ---------------------------------------------------------------------------
% ghbmath -- math shorthands shared by every build path.
%
% Loaded by the HTML conversion, the PDF build, and the standalone wrapper used
% to extract figures. Put anything here that you want available both in body
% text and inside a tikzpicture.
% ---------------------------------------------------------------------------
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ghbmath}[2026/08/16 shared math macros]

\RequirePackage{amsmath}
\RequirePackage{amssymb}

\newcommand{\R}{\mathbb{R}}
\newcommand{\N}{\mathbb{N}}
\newcommand{\Z}{\mathbb{Z}}
\newcommand{\E}{\mathbb{E}}
\newcommand{\Prob}{\mathbb{P}}

\DeclareMathOperator{\poly}{poly}
\DeclareMathOperator{\OPT}{OPT}

% Fixed-size parentheses, deliberately not \left(...\right). Browsers stretch
% \left delimiters to clear a superscript much harder than TeX does, so
% \bigO{n^3} came out with oversized brackets. Plain parens match the text.
\newcommand{\bigO}[1]{O(#1)}

% These keep \left...\right because their contents are often tall (fractions,
% sums) and genuinely need to stretch. Use \setbig etc. only when they do.
\newcommand{\set}[1]{\{#1\}}
\newcommand{\setbig}[1]{\left\{#1\right\}}
\newcommand{\abs}[1]{\lvert#1\rvert}
\newcommand{\absbig}[1]{\left\lvert#1\right\rvert}
\newcommand{\norm}[1]{\lVert#1\rVert}
\newcommand{\normbig}[1]{\left\lVert#1\right\rVert}

\endinput
